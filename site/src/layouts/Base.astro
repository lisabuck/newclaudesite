---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  preloadImage?: string;
  hideNewsletterButton?: boolean;
}
const { title, description, preloadImage, hideNewsletterButton } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thorne Group" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:image" content="https://static.wixstatic.com/media/b2375c_5f56ac352c78400c82cdc283069c432f~mv2.jpg/v1/fill/w_1200,h_630,q_85,enc_auto/b2375c_5f56ac352c78400c82cdc283069c432f~mv2.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="An architectural home with a pool, built by Thorne Group" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://static.wixstatic.com/media/b2375c_5f56ac352c78400c82cdc283069c432f~mv2.jpg/v1/fill/w_1200,h_630,q_85,enc_auto/b2375c_5f56ac352c78400c82cdc283069c432f~mv2.jpg" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': 'https://www.thornegroup.co.nz/#business',
      name: 'Thorne Group',
      description: 'Award-winning architectural builders in Tauranga and the Bay of Plenty. Registered Master Builders. New homes, renovations and development collaborations.',
      url: 'https://www.thornegroup.co.nz',
      telephone: '+64 7 575 5555',
      email: 'info@thornegroup.co.nz',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Unit 1, 41 Newton Street',
        addressLocality: 'Mount Maunganui',
        addressRegion: 'Bay of Plenty',
        postalCode: '3116',
        addressCountry: 'NZ',
      },
      areaServed: ['Tauranga', 'Mount Maunganui', 'Bay of Plenty'],
      memberOf: { '@type': 'Organization', name: 'Registered Master Builders Association of New Zealand' },
      award: 'Most Trusted Architectural Builder, Bay of Plenty (five years running)',
      sameAs: [
        'https://www.facebook.com/thornegroup',
        'https://www.linkedin.com/company/thorne-group',
        'https://www.instagram.com/thornegroup',
      ],
    })} />
  </head>
  <body>
    <div id="tg-preloader" aria-hidden="true">
      <div class="pre-words"><span class="pre-w pre-w-left">Celebrating</span><span class="pre-w pre-w-right">20 Years</span></div>
      <img class="pre-icon" src="https://static.wixstatic.com/media/b2375c_49b40a149c39413eb1d914c0718a3a42~mv2.png" alt="" decoding="async" fetchpriority="high" />
      <img class="pre-logo" src="https://static.wixstatic.com/media/b2375c_ef5eca5407f14e7ca8999f7efc3e8d1f~mv2.png" alt="" decoding="async" fetchpriority="high" />
    </div>
    <style is:inline>
      #tg-preloader{position:fixed;inset:0;z-index:200;background:#2e2b29;display:flex;align-items:center;justify-content:center;transition:opacity .65s ease}
      #tg-preloader.done{opacity:0;pointer-events:none}
      /* faint celebration text, sweeping in from each side */
      /* three distinct steps: 1. icon grows then vanishes, 2. words alone, 3. full logo */
      #tg-preloader .pre-words{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);display:flex;justify-content:center;align-items:center;font-size:clamp(34px,8.5vw,104px);gap:.3em;pointer-events:none;white-space:nowrap}
      #tg-preloader .pre-w{font-family:'Metric',system-ui,sans-serif;font-weight:300;font-size:inherit;letter-spacing:.01em;color:rgba(250,249,246,.88);opacity:0}
      #tg-preloader .pre-w-left{animation:tgPreL 1.1s cubic-bezier(.22,.61,.36,1) 1.9s forwards,tgPreOut .45s ease 3.5s forwards}
      #tg-preloader .pre-w-right{animation:tgPreR 1.1s cubic-bezier(.22,.61,.36,1) 1.9s forwards,tgPreOut .45s ease 3.5s forwards}
      @keyframes tgPreL{from{opacity:0;transform:translateX(min(-14vw,-110px))}to{opacity:1;transform:none}}
      @keyframes tgPreR{from{opacity:0;transform:translateX(max(14vw,110px))}to{opacity:1;transform:none}}
      #tg-preloader .pre-icon{position:relative;max-width:min(30vw,150px);max-height:26vh;width:auto;height:auto;opacity:0;animation:tgPreIn .5s ease .1s forwards,tgPreGrow 1.8s ease .1s forwards,tgPreOut .45s ease 1.45s forwards}
      #tg-preloader .pre-logo{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:min(64vw,340px);max-height:44vh;width:auto;height:auto;opacity:0;animation:tgPreIn .8s ease 4s forwards,tgLogoGrow 2.4s ease 4s forwards}
      @keyframes tgPreIn{to{opacity:1}}
      @keyframes tgPreOut{to{opacity:0}}
      @keyframes tgPreGrow{from{transform:scale(1)}to{transform:scale(1.12)}}
      @keyframes tgLogoGrow{from{transform:translate(-50%,-50%) scale(1)}to{transform:translate(-50%,-50%) scale(1.1)}}
      @media(prefers-reduced-motion:reduce){
        #tg-preloader .pre-w,#tg-preloader .pre-icon{animation:none;opacity:0}
        #tg-preloader .pre-logo{animation:none;opacity:1}
      }
    </style>
    <script is:inline>
      (function () {
        var p = document.getElementById('tg-preloader');
        /* Intro plays only on the first arrival at the site: skip it when moving
           between pages, and remember across tabs for 12 hours so links that
           open in a new tab do not replay it. */
        try {
          var seenAt = 0;
          try { seenAt = +localStorage.getItem('tgPreSeen') || 0; } catch (e) {}
          if (sessionStorage.getItem('tgPreSeen') || (seenAt && Date.now() - seenAt < 43200000)) {
            if (p && p.parentNode) p.parentNode.removeChild(p);
            return;
          }
          sessionStorage.setItem('tgPreSeen', '1');
          try { localStorage.setItem('tgPreSeen', String(Date.now())); } catch (e) {}
        } catch (e) { /* private browsing: just play the intro */ }
        var t0 = Date.now(), MIN = 5400, hidden = false;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) MIN = 400;
        function hide() {
          if (hidden) return; hidden = true;
          var wait = Math.max(0, MIN - (Date.now() - t0));
          setTimeout(function () {
            p.classList.add('done');
            setTimeout(function () { if (p.parentNode) p.parentNode.removeChild(p); }, 750);
          }, wait);
        }
        if (document.readyState === 'complete') hide();
        else window.addEventListener('load', hide);
        setTimeout(hide, 8500); /* never trap the visitor if something stalls */
      })();
    </script>
    <Header />
    <main>
      <slot />
    </main>
    <script is:inline defer src="/js/fixlinks.js?v=2"></script>
    <script is:inline defer src="/js/tg-countup.js?v=1"></script>
      {!hideNewsletterButton && (
      <a class="tg-news-cta" href="/newsletter" target="_blank" rel="noopener">E-Newsletter</a>
    )}
    <script is:inline>
      /* lift the pinned E-Newsletter button clear of the footer social links
         once the visitor reaches the bottom of the page */
      (function () {
        var b = document.querySelector('.tg-news-cta'); if (!b) return;
        function place () {
          var gap = document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);
          b.classList.toggle('tg-news-up', gap < 96);
        }
        window.addEventListener('scroll', place, { passive: true });
        window.addEventListener('resize', place);
        place();
      })();
    </script>
    <!-- Project updates pop-up: shows 30 seconds into a visit (not on the
         newsletter or contact pages). Closing it keeps it away for 30 days;
         signing up keeps it away for good. Sign-ups go to the Wix
         "Newsletter Signup" form through the site's existing /api/contact
         connector; on the preview site (no connector) it says so instead. -->
    <div class="tg-pop" id="tg-pop" hidden data-form-id="">
      <div class="tg-pop-card" role="dialog" aria-modal="true" aria-labelledby="tg-pop-h">
        <button class="tg-pop-x" type="button" aria-label="Close">&times;</button>
        <h2 id="tg-pop-h">Interested in our current projects?</h2>
        <p class="tg-pop-lead">Early access to new developments, inspiration from our homes and updates on current projects.</p>
        <form class="tg-pop-form" novalidate>
          <label class="tg-pop-lab" for="tg-pop-first">First name</label>
          <input id="tg-pop-first" name="first_name" type="text" autocomplete="given-name" required>
          <label class="tg-pop-lab" for="tg-pop-email">Email address</label>
          <input id="tg-pop-email" name="email" type="email" autocomplete="email" required>
          <button class="tg-pop-btn" type="submit">Keep me updated</button>
          <p class="tg-pop-msg" role="status" hidden></p>
        </form>
      </div>
    </div>
    <style is:inline>
      .tg-pop{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(35,32,30,.55);opacity:0;transition:opacity .45s ease}
      .tg-pop[hidden]{display:none}
      .tg-pop.on{opacity:1}
      .tg-pop-card{position:relative;width:100%;max-width:480px;max-height:calc(100vh - 40px);overflow:auto;background:#FAF9F6;color:#393533;padding:48px 40px 40px;font-family:'Metric',system-ui,sans-serif}
      .tg-pop-x{position:absolute;top:10px;right:10px;width:44px;height:44px;border:0;background:none;color:#393533;font-size:30px;line-height:1;font-weight:300;cursor:pointer}
      .tg-pop-x:hover{color:#7a746e}
      .tg-pop-card h2{margin:0 24px 0 0;font-weight:300;font-size:clamp(27px,3vw,34px);line-height:1.2;letter-spacing:-.02em;color:#393533}
      .tg-pop-lead{margin:16px 0 24px;font-size:18px;line-height:1.65;color:#54504c}
      .tg-pop-lab{display:block;margin:0 0 6px;font-size:14px;font-weight:400;letter-spacing:.2em;text-transform:uppercase;color:#54504c}
      .tg-pop-form input{display:block;width:100%;box-sizing:border-box;margin:0 0 16px;padding:13px 14px;border:1px solid #c8c3bb;border-radius:0;background:#fff;font:inherit;font-size:17px;color:#393533}
      .tg-pop-form input:focus{outline:2px solid #393533;outline-offset:1px;border-color:#393533}
      .tg-pop-btn{display:block;width:100%;margin-top:6px;padding:15px 24px;border:1px solid #393533;background:#393533;color:#FAF9F6;font:inherit;font-size:14px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;cursor:pointer}
      .tg-pop-btn:hover{background:#54504c}
      .tg-pop-btn[disabled]{opacity:.6;cursor:default}
      .tg-pop-msg{margin:14px 0 0;font-size:16px;line-height:1.5;color:#393533}
      @media(max-width:750px){.tg-pop-card{padding:44px 24px 28px}.tg-pop-lead{font-size:17px}}
      @media(prefers-reduced-motion:reduce){.tg-pop{transition:none}}
    </style>
    <script is:inline>
      (function () {
        var pop = document.getElementById('tg-pop'); if (!pop) return;
        var path = location.pathname.replace(/\/+$/, '');
        if (/^\/(newsletter|contact)$/.test(path)) return;
        var KEY = 'tgPopState', DAY = 86400000;
        function get() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
        function set(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} }
        var st = get();
        if (st && (st.done || (st.closed && Date.now() - st.closed < 30 * DAY))) return;
        var lastFocus = null;
        function open() {
          if (document.querySelector('.tg-pop.on')) return;
          lastFocus = document.activeElement;
          pop.hidden = false;
          requestAnimationFrame(function () { pop.classList.add('on'); });
          setTimeout(function () { var f = document.getElementById('tg-pop-first'); if (f) f.focus({ preventScroll: true }); }, 60);
        }
        function close(done) {
          set(done ? { done: Date.now() } : { closed: Date.now() });
          pop.classList.remove('on');
          setTimeout(function () { pop.hidden = true; }, 450);
          if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
        }
        pop.querySelector('.tg-pop-x').addEventListener('click', function () { close(false); });
        pop.addEventListener('click', function (e) { if (e.target === pop) close(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !pop.hidden) close(false); });
        var form = pop.querySelector('form'), msg = pop.querySelector('.tg-pop-msg'), btn = pop.querySelector('.tg-pop-btn');
        function say(t) { msg.textContent = t; msg.hidden = false; }
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var first = form.first_name.value.trim(), email = form.email.value.trim();
          if (!first || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { say('Please add your first name and a valid email address.'); return; }
          var formId = pop.getAttribute('data-form-id');
          if (!formId) { say('Preview only: sign-ups are connected on the live site.'); return; }
          btn.disabled = true; btn.textContent = 'Sending...';
          fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ formId: formId, submissions: { first_name: first, email: email, newsletter: true } }) })
            .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, b: b }; }); })
            .then(function (r) {
              if (!r.ok) throw new Error((r.b && r.b.error) || 'Something went wrong.');
              form.querySelectorAll('input,.tg-pop-btn,.tg-pop-lab').forEach(function (el) { el.hidden = true; });
              say('Thank you. We’ll keep you posted.');
              set({ done: Date.now() });
              setTimeout(function () { close(true); }, 3500);
            })
            .catch(function (err) { say((err && err.message) || 'Something went wrong. Please try again or email info@thornegroup.co.nz.'); })
            .then(function () { btn.disabled = false; btn.textContent = 'Keep me updated'; });
        });
        setTimeout(open, 30000);
      })();
    </script>
</body>
</html>
