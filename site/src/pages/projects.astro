---
import Base from '../layouts/Base.astro';
import body from '../html/thorne-gallery.html?raw';
import '../styles/pages/thorne-gallery.css';
---
<Base
  title="Architect Designed Homes | Tauranga | Thorne Group"
  description="Award-winning architect designed homes across Tauranga, Mount Maunganui and the Bay of Plenty. Coastal, rural and urban projects from concept to completion."
>
  <thorne-gallery set:html={body}></thorne-gallery>
  <script is:inline defer src="/js/lightdom-shim.js?v=1"></script>
  <script is:inline defer src="/js/GALLERY6.js?v=30"></script>
  <script is:inline defer>
/* open-from-hash: /projects#on-the-dunes opens that project's slideshow */
(function () {
  function openFromHash() {
    var want = decodeURIComponent(location.hash.slice(1)).replace(/-/g, ' ').toLowerCase().trim();
    if (!want) return;
    var el = document.querySelector('thorne-gallery');
    if (!el) return;
    var card = Array.prototype.slice.call(el.querySelectorAll('.card')).find(function (c) {
      return (c.getAttribute('aria-label') || '').toLowerCase().indexOf(want) !== -1;
    });
    if (!card) return;
    var head = null;
    el.querySelectorAll('button.acc-head').forEach(function (hd) {
      var id = hd.getAttribute('aria-controls');
      var panel = id ? document.getElementById(id) : null;
      if (panel && panel.contains(card)) head = hd;
    });
    if (head && head.getAttribute('aria-expanded') !== 'true') head.click();
    setTimeout(function () { card.click(); }, 350);
  }
  window.addEventListener('load', function () { setTimeout(openFromHash, 600); });
})();
  </script>
  <script is:inline defer>
/* Slideshow extras: portrait photos get a 4:5 frame (see .tg-portrait in the
   page CSS), and a "Next project" button appears when a slideshow reaches its
   last photo. Both run off a light poll while the theatre is open. */
(function () {
  var lastCard = null;
  var nextBtn = null;

  document.addEventListener('click', function (e) {
    var card = e.target && e.target.closest && e.target.closest('.card');
    if (card) lastCard = card;
  }, true);

  function cards() {
    return Array.prototype.slice.call(document.querySelectorAll('.card[data-p]'));
  }

  function ensureButton(top) {
    if (nextBtn && nextBtn.isConnected) return nextBtn;
    nextBtn = document.createElement('button');
    nextBtn.type = 'button';
    nextBtn.className = 'th-b th-nextproj';
    nextBtn.textContent = 'Next project →';
    nextBtn.style.display = 'none';
    nextBtn.addEventListener('click', function () {
      var list = cards();
      var i = list.indexOf(lastCard);
      var next = list[(i + 1) % list.length] || list[0];
      var closeBtn = document.querySelector('.th-close');
      if (closeBtn) closeBtn.click();
      setTimeout(function () { if (next) next.click(); }, 350);
    });
    top.appendChild(nextBtn);
    return nextBtn;
  }

  setInterval(function () {
    var th = document.querySelector('.th.open');
    if (!th) { if (nextBtn) nextBtn.style.display = 'none'; return; }
    /* 4:5 framing for whichever photo is currently loaded */
    th.querySelectorAll('img.th-img').forEach(function (img) {
      if (img.naturalWidth) img.classList.toggle('tg-portrait', img.naturalHeight > img.naturalWidth);
    });
    /* reveal Next project once the counter reaches the final photo */
    var top = th.querySelector('.th-top');
    var ct = th.querySelector('.th-counter');
    if (!top || !ct) return;
    var btn = ensureButton(top);
    var m = /(\d+)\s*(?:\/|of)\s*(\d+)/.exec(ct.textContent || '');
    if (m && m[1] === m[2]) btn.style.display = '';
  }, 250);
})();
  </script>
</Base>
