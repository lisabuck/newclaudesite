---
import Base from '../layouts/Base.astro';
import body from '../html/thorne-gallery.html?raw';
import '../styles/pages/thorne-gallery.css';
---
<Base
  title="Architect Designed Homes | Tauranga | Thorne Group"
  description="Award-winning architect designed homes across Tauranga, Mount Maunganui and the Bay of Plenty. Coastal, rural and urban projects from concept to completion."
>
  <thorne-gallery set:html={body}></thorne-gallery>
  <script is:inline defer src="/js/lightdom-shim.js?v=1"></script>
  <script is:inline defer src="/js/GALLERY6.js?v=45"></script>
  <script is:inline defer>
/* open-from-hash: /projects#on-the-dunes opens that project's slideshow */
(function () {
  function openFromHash() {
    var want = decodeURIComponent(location.hash.slice(1)).replace(/-/g, ' ').toLowerCase().trim();
    if (!want) return;
    /* renamed projects: old links keep working */
    var ALIASES = { 'north face': 'coastal sanctuary' };
    if (ALIASES[want]) want = ALIASES[want];
    var el = document.querySelector('thorne-gallery');
    if (!el) return;
    var card = Array.prototype.slice.call(el.querySelectorAll('.card')).find(function (c) {
      return (c.getAttribute('aria-label') || '').toLowerCase().indexOf(want) !== -1;
    });
    if (!card) return;
    var head = null;
    el.querySelectorAll('button.acc-head').forEach(function (hd) {
      var id = hd.getAttribute('aria-controls');
      var panel = id ? document.getElementById(id) : null;
      if (panel && panel.contains(card)) head = hd;
    });
    if (head && head.getAttribute('aria-expanded') !== 'true') head.click();
    setTimeout(function () { card.click(); }, 350);
  }
  window.addEventListener('load', function () { setTimeout(openFromHash, 600); });
})();
  </script>
  <script is:inline defer>
/* Slideshow extras: portrait photos get a 4:5 frame (see .tg-portrait in the
   page CSS). Runs off a light poll while the theatre is open. */
(function () {
  setInterval(function () {
    var th = document.querySelector('.th.open');
    if (!th) return;
    th.querySelectorAll('img.th-img').forEach(function (img) {
      if (img.naturalWidth) img.classList.toggle('tg-portrait', img.naturalHeight > img.naturalWidth);
    });
  }, 250);
})();
  </script>
  <script is:inline defer>
/* Last photo of each project: show a call-to-action panel (over the photo
   on larger screens, under it on phones). It reads the slideshow counter
   ("6 of 6"), so the slideshow script itself is unchanged. */
(function () {
  var card = null, closedFor = '';
  /* closing it hides it for that project's last photo until the slideshow is reopened */
  function key(th) { return ((th.querySelector('.th-title') || {}).textContent || '') + '|' + ((th.querySelector('.th-counter') || {}).textContent || ''); }
  function build(th) {
    card = document.createElement('div');
    card.className = 'th-endcta';
    card.setAttribute('role', 'note');
    card.innerHTML = '<button class="th-endcta-x" type="button" aria-label="Close">&times;</button>' +
      '<p>Interested in finding out more about the cost to build specific projects?</p>' +
      '<a class="th-endcta-btn" href="tel:+6475755555" aria-label="Give us a call for a chat on 07 575 5555">Give us a call for a chat <span aria-hidden="true">&rarr;</span></a>' +
      '<span class="th-endcta-nums" hidden><span class="th-endcta-lab">Office</span> <a href="tel:+6475755555">07 575 5555</a><span class="th-endcta-sep" aria-hidden="true">/</span><span class="th-endcta-lab">Clare</span> <a href="tel:+64272813850">027 281 3850</a></span>';
    var stage = th.querySelector('.th-stage');
    stage.parentNode.insertBefore(card, stage.nextSibling);
    card.querySelector('.th-endcta-x').addEventListener('click', function () {
      closedFor = key(th);
      card.classList.remove('on');
    });
    card.querySelector('.th-endcta-btn').addEventListener('click', function (e) {
      if (window.matchMedia('(max-width:750px)').matches) return; /* phones dial */
      e.preventDefault();
      var n = card.querySelector('.th-endcta-nums'); n.hidden = !n.hidden;
    });
  }
  setInterval(function () {
    var th = document.querySelector('thorne-gallery .th');
    if (!th) return;
    if (!card || !card.isConnected) build(th);
    if (!th.classList.contains('open')) { card.classList.remove('on'); closedFor = ''; return; }
    var m = ((th.querySelector('.th-counter') || {}).textContent || '').match(/(\d+)\s+of\s+(\d+)/);
    var last = !!m && m[1] === m[2] && key(th) !== closedFor;
    if (last !== card.classList.contains('on')) {
      card.classList.toggle('on', last);
      if (!last) card.querySelector('.th-endcta-nums').hidden = true;
    }
  }, 200);
})();
  </script>
</Base>
