---
import Base from '../layouts/Base.astro';
import body from '../html/thorne-gallery.html?raw';
import '../styles/pages/thorne-gallery.css';
---
<Base
  title="Architect Designed Homes | Tauranga | Thorne Group"
  description="Award-winning architect designed homes across Tauranga, Mount Maunganui and the Bay of Plenty. Coastal, rural and urban projects from concept to completion."
>
  <thorne-gallery set:html={body}></thorne-gallery>
  <script is:inline defer src="/js/lightdom-shim.js?v=1"></script>
  <script is:inline defer src="/js/GALLERY6.js?v=45"></script>
  <script is:inline defer>
/* open-from-hash: /projects#on-the-dunes opens that project's slideshow */
(function () {
  function openFromHash() {
    var want = decodeURIComponent(location.hash.slice(1)).replace(/-/g, ' ').toLowerCase().trim();
    if (!want) return;
    /* renamed projects: old links keep working */
    var ALIASES = { 'north face': 'coastal sanctuary' };
    if (ALIASES[want]) want = ALIASES[want];
    var el = document.querySelector('thorne-gallery');
    if (!el) return;
    var card = Array.prototype.slice.call(el.querySelectorAll('.card')).find(function (c) {
      return (c.getAttribute('aria-label') || '').toLowerCase().indexOf(want) !== -1;
    });
    if (!card) return;
    var head = null;
    el.querySelectorAll('button.acc-head').forEach(function (hd) {
      var id = hd.getAttribute('aria-controls');
      var panel = id ? document.getElementById(id) : null;
      if (panel && panel.contains(card)) head = hd;
    });
    if (head && head.getAttribute('aria-expanded') !== 'true') head.click();
    setTimeout(function () { card.click(); }, 350);
  }
  window.addEventListener('load', function () { setTimeout(openFromHash, 600); });
})();
  </script>
  <script is:inline defer>
/* Slideshow extras: portrait photos get a 4:5 frame (see .tg-portrait in the
   page CSS). Runs off a light poll while the theatre is open. */
(function () {
  setInterval(function () {
    var th = document.querySelector('.th.open');
    if (!th) return;
    th.querySelectorAll('img.th-img').forEach(function (img) {
      if (img.naturalWidth) img.classList.toggle('tg-portrait', img.naturalHeight > img.naturalWidth);
    });
  }, 250);
})();
  </script>
</Base>
