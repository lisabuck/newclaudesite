---
/* Our process, option C (preview only): a numbered track across the top
   (the two pricing checks tinted), then one large panel showing a
   single step at a time with a big photo, the full text and previous /
   next. Every step's panel is in the page; only the chosen one shows. */
import ProcessShell from '../components/ProcessShell.astro';
import { STEPS, photo, pad } from '../data/our-process';
---
<ProcessShell option="c">
  <style is:global>
    .rc{margin-top:56px;max-width:1032px}
    .rc-track{position:relative;list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:0}
    .rc-track::before{content:'';position:absolute;left:4%;right:4%;top:27px;border-top:1px solid #c8c3bb}
    .rc-track li{display:flex;justify-content:center}
    .rc-node{position:relative;z-index:1;width:54px;height:54px;border:1px solid #393533;background:#FAF9F6;cursor:pointer;font-family:inherit;font-weight:400;font-size:16px;letter-spacing:.06em;color:#393533;transition:background .2s ease,color .2s ease}
    .rc-node.price{background:#E8E4DE}
    .rc-node:hover{background:#393533;color:#FAF9F6}
    .rc-node[aria-current="step"]{background:#393533;color:#FAF9F6;outline:1px solid #393533;outline-offset:4px}
    .rc-node:focus-visible{outline:1px solid #393533;outline-offset:4px}
    .rc-key{display:flex;gap:18px;margin:16px 0 0;font-weight:400;font-size:14px;letter-spacing:.15em;text-transform:uppercase;color:#7a746e}
    .rc-key span::before{content:'';display:inline-block;width:12px;height:12px;margin-right:8px;vertical-align:-1px;border:1px solid #393533;background:#E8E4DE}
    .rc-panel{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);margin-top:36px;background:#F2F0ED;min-height:520px;scroll-margin-top:130px}
    .rc-panel[hidden]{display:none}
    .rc-panel.price{background:#393533;color:#FAF9F6}
    .rc-ph{position:relative;background:#e8e4de;overflow:hidden}
    .rc-ph img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover}
    .rc-tx{display:grid;gap:14px;align-content:start;padding:40px 40px 36px}
    .rc-of{font-weight:400;font-size:14px;letter-spacing:.3em;text-transform:uppercase;color:#7a746e}
    .rc-panel.price .rc-of{color:#c8c3bb}
    .rc-big{font-weight:300;font-size:72px;line-height:.9;letter-spacing:-.03em}
    .rc-tx h2{margin:0;font-weight:500;font-size:19px;line-height:1.4;letter-spacing:.1em;text-transform:uppercase}
    .rc-lead{margin:0 0 6px;font-weight:300;font-size:22px;line-height:1.45;letter-spacing:-.01em}
    .rc-nav{display:flex;justify-content:space-between;gap:12px;margin-top:20px}
    .rc-nav button{min-height:48px;padding:12px 20px;border:1px solid #393533;background:transparent;cursor:pointer;font-family:inherit;font-weight:400;font-size:14px;letter-spacing:.2em;text-transform:uppercase;color:#393533}
    .rc-nav button:hover{background:#393533;color:#FAF9F6}
    .rc-nav button[disabled]{opacity:.3;cursor:default;background:transparent;color:#393533}
    .rc-panel.price .rc-nav button{border-color:#FAF9F6;color:#FAF9F6}
    .rc-panel.price .rc-nav button:hover{background:#FAF9F6;color:#393533}
    .rc-panel.price .rc-nav button[disabled]{background:transparent;color:#FAF9F6}
    @media (max-width:1000px){
      .rc-node{width:44px;height:44px;font-size:15px}
      .rc-track::before{top:22px}
      .rc-panel{grid-template-columns:1fr;min-height:0}
      .rc-ph img{position:static;aspect-ratio:3/2;height:auto}
    }
    @media (max-width:750px){
      .rc-track{display:flex;overflow-x:auto;gap:10px;padding:6px 4px 10px;scrollbar-width:thin}
      .rc-track::before{display:none}
      .rc-track li{flex:0 0 auto}
      .rc-tx{padding:24px 20px 24px}
      .rc-big{font-size:56px}
      .rc-lead{font-size:20px}
      .rc-nav button{padding:12px 12px;letter-spacing:.12em}
    }
  </style>

  <div class="rc">
    <ol class="rc-track" aria-label="Steps">
      {STEPS.map((s) => (
        <li><button class={s.price ? 'rc-node price' : 'rc-node'} type="button" data-n={s.n} aria-label={`Step ${s.n}: ${s.title}`}>{pad(s.n)}</button></li>
      ))}
    </ol>
    <div class="rc-key"><span>Pricing checks</span></div>

    {STEPS.map((s, i) => (
      <section class={s.price ? 'rc-panel price dark' : 'rc-panel'} id={`step-${s.n}`} data-n={s.n} hidden={i !== 0}>
        <div class="rc-ph"><img src={photo(s.id, 1200)} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" style={`object-position:${s.pos}`} /></div>
        <div class="rc-tx">
          <span class="rc-of">Step {s.n} of {STEPS.length}</span>
          <span class="rc-big">{pad(s.n)}</span>
          {s.price && <span class="chip">Pricing check {s.price} of 2</span>}
          <h2>{s.title}</h2>
          <p class="rc-lead">{s.sum}</p>
          <div class="dt" set:html={s.more} />
          <div class="rc-nav">
            <button type="button" data-go={s.n - 1} disabled={s.n === 1}>&larr; Previous</button>
            <button type="button" data-go={s.n + 1} disabled={s.n === STEPS.length}>Next &rarr;</button>
          </div>
        </div>
      </section>
    ))}
  </div>

  <script is:inline>
  (function () {
    var rc = document.querySelector('.rc'), track = rc.querySelector('.rc-track'), head = document.querySelector('.op-top');
    var panels = Array.prototype.slice.call(rc.querySelectorAll('.rc-panel'));
    var nodes = Array.prototype.slice.call(rc.querySelectorAll('.rc-node'));
    /* where the track sits below the sticky header (the header scrolls away on phones) */
    function trackTop() { var h = getComputedStyle(head).position === 'sticky' ? head.offsetHeight : 0; return rc.getBoundingClientRect().top + window.scrollY - h - 16; }
    function show(n) {
      panels.forEach(function (p) { p.hidden = +p.dataset.n !== n; });
      nodes.forEach(function (b) {
        if (+b.dataset.n !== n) { b.removeAttribute('aria-current'); return; }
        b.setAttribute('aria-current', 'step');
        /* phones: slide the track sideways so the chosen number is in view, without moving the page */
        if (track.scrollWidth > track.clientWidth) track.scrollLeft = b.offsetLeft - (track.clientWidth - b.offsetWidth) / 2;
      });
    }
    nodes.forEach(function (b) { b.addEventListener('click', function () { show(+b.dataset.n); }); });
    rc.querySelectorAll('.rc-nav button').forEach(function (b) { b.addEventListener('click', function () { show(+b.dataset.go); var t = trackTop(); if (window.scrollY > t) window.scrollTo({ top: t }); }); });
    function fromHash() { var m = location.hash.match(/^#step-(\d+)$/); if (m && +m[1] >= 1 && +m[1] <= panels.length) { show(+m[1]); window.scrollTo({ top: trackTop() }); } }
    window.addEventListener('hashchange', fromHash);
    show(1); fromHash();
  })();
  </script>
</ProcessShell>
