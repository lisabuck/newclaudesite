---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page Not Found | Thorne Group"
  description="Sorry, this page isn't active any more. Head back to the Thorne Group home page, or take a look at our latest projects."
>
  <div class="nf-wrap">
    <span class="nf-eyebrow">Page not found</span>
    <h1>Sorry, this page isn't active any more</h1>
    <p>The address may have changed when we refreshed our website.</p>
    <div class="nf-actions">
      <a class="nf-btn" href="/">Back to the home page</a>
      <a class="nf-link" href="/projects">View our projects</a>
      <a class="nf-link" href="/contact">Contact us</a>
    </div>
  </div>
</Base>
<style is:inline>
  /* cream page top: the menu bar keeps its frosted background and dark logo,
     same treatment as the articles and inspiration pages */
  .tg-nav.at-top{ background:rgba(242,240,237,.7) !important; backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); border-bottom:1px solid #c8c3bb !important; }
  .tg-nav.at-top::before{ display:none; }
  .tg-nav.at-top .tg-logo{ filter:brightness(0) !important; }
  .tg-nav.at-top .tg-burger span{ background:#393533 !important; }
  .tg-nav.at-top .tg-wordmark{ color:#393533 !important; text-shadow:none !important; }
  .tg-nav.at-top .tg-links-list > li > a,
  .tg-nav.at-top .tg-links-list > li > .tg-drop-btn{ color:#393533 !important; text-shadow:none !important; }
  .tg-nav.at-top .tg-links-list > li > a.tg-current,
  .tg-nav.at-top .tg-links-list > li > .tg-drop-btn.tg-current{ border-bottom-color:#393533 !important; }
  .nf-wrap{ min-height:72vh; display:flex; flex-direction:column; justify-content:center; align-items:flex-start; max-width:1440px; margin:0 auto; padding:140px 56px 96px; background:#FAF9F6; font-family:'Metric','Helvetica Neue',Arial,sans-serif; color:#54504c; }
  .nf-eyebrow{ font-size:14px; font-weight:500; letter-spacing:.28em; text-transform:uppercase; color:#7a746e; margin-bottom:22px; }
  h1{ margin:0; font-weight:300; font-size:clamp(30px,3.6vw,52px); line-height:1.15; letter-spacing:-.025em; color:#393533; max-width:18em; text-wrap:balance; }
  p{ margin:22px 0 0; font-size:clamp(18px,1.5vw,21px); line-height:1.65; max-width:34em; }
  .nf-actions{ display:flex; align-items:center; gap:28px; flex-wrap:wrap; margin-top:40px; }
  .nf-btn{ display:inline-block; font-size:14px; font-weight:500; letter-spacing:.28em; text-transform:uppercase; color:#FAF9F6; background:#393533; text-decoration:none; padding:18px 40px; }
  .nf-btn:hover{ opacity:.88; }
  .nf-link{ font-size:14px; font-weight:500; letter-spacing:.22em; text-transform:uppercase; color:#393533; text-decoration:none; border-bottom:1px solid #c8c3bb; padding-bottom:4px; }
  .nf-link:hover{ color:#7a746e; }
  @media (max-width:750px){ .nf-wrap{ padding:120px 24px 72px; } .nf-actions{ gap:20px; } .nf-btn{ display:block; width:100%; text-align:center; } }
</style>
