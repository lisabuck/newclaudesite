---
import Base from '../layouts/Base.astro';
import body from '../html/thorne-home-page.html?raw';
import '../styles/pages/thorne-home-page.css';
---
<Base
  title="Most Trusted Architectural Builder Tauranga | Thorne Group"
  description="Award-winning architectural builders in Tauranga for 20 years. From concept to completion. New homes, renovations and development collaborations."
  preloadImage="https://static.wixstatic.com/media/b2375c_85010d213e844bfc858b75405bd2748f~mv2.jpg/v1/fit/w_1920,h_1200,q_85,enc_auto/b2375c_85010d213e844bfc858b75405bd2748f~mv2.jpg"
>
  <thorne-home-page class="tg-home" set:html={body}></thorne-home-page>
  <script is:inline defer src="/js/lightdom-shim.js?v=1"></script>
  <script is:inline defer src="/js/thorne-home-page54.js?v=88"></script>
  <script is:inline>
/* hero rotation starts only once every hero photo has arrived, so no slide
   ever shows blank (the first photo holds still until then) */
document.addEventListener('DOMContentLoaded', function () {
  var host = document.querySelector('thorne-home-page'); if (!host) return;
  function ready() { host.setAttribute('data-hero-ready', ''); }
  var imgs = host.querySelectorAll('.tg-hero-slides img'), left = 0;
  imgs.forEach(function (im) {
    if (im.complete && im.naturalWidth) return;
    left++;
    function one() { if (--left === 0) ready(); }
    im.addEventListener('load', one, { once: true });
    im.addEventListener('error', one, { once: true });
  });
  if (left === 0) ready();
  setTimeout(ready, 15000); /* very slow connection: start anyway */
});
/* Architectural Homes band: its photo rotation starts when the band scrolls
   into view, so it always opens on the dusk photo */
document.addEventListener('DOMContentLoaded', function () {
  var host = document.querySelector('thorne-home-page'); if (!host) return;
  var band = host.querySelector('.tg-band[data-screen-label="Architectural Homes band"]');
  function go() { host.setAttribute('data-arch-go', ''); }
  if (!band || !('IntersectionObserver' in window)) { go(); return; }
  var io = new IntersectionObserver(function (es) {
    if (es.some(function (x) { return x.isIntersecting; })) { go(); io.disconnect(); }
  }, { threshold: 0.35 });
  io.observe(band);
});
/* "Call Us for a Chat": phones dial the office straight away; tablets and
   computers show the office and Clare's numbers instead */
document.addEventListener('click', function (e) {
  var b = e.target.closest && e.target.closest('.tg-callbtn');
  if (!b || window.matchMedia('(max-width:750px)').matches) return;
  var nums = b.parentNode.querySelector('.tg-callnums'); if (!nums) return;
  e.preventDefault();
  nums.hidden = !nums.hidden;
  b.setAttribute('aria-expanded', nums.hidden ? 'false' : 'true');
});
  </script>
  <script is:inline defer>
/* Project links on the home page open in a new tab, keeping home open. */
window.addEventListener('load', function () {
  document.querySelectorAll('a[href^="/projects"]').forEach(function (a) {
    a.target = '_blank';
    a.rel = 'noopener';
  });
});
  </script>
</Base>
