---
import Base from '../../layouts/Base.astro';
import body from '../../html/thorne-testimonials.html?raw';
import '../../styles/pages/thorne-testimonials.css';
---
<Base
  title="Client Testimonials | Thorne Group, Bay of Plenty"
  description="A reputation built one client at a time. What clients say about building with Thorne Group over the past 20 years, in their own words."
>
  <thorne-testimonials set:html={body}></thorne-testimonials>
  <script is:inline defer src="/js/lightdom-shim.js"></script>
  <script is:inline defer src="/js/thorne-testimonials26.js"></script>
  <script is:inline defer>
/* First nine testimonials show; the rest reveal with one click, so the page has a single scroll. */
window.addEventListener('load', function () {
  var sec = document.getElementById('tg-voices'), grid = document.getElementById('grid');
  if (!sec || !grid) return;
  var cards = grid.querySelectorAll('.t-card');
  if (cards.length <= 9) return;
  sec.classList.add('tg-collapsed');
  var btn = document.createElement('button');
  btn.type = 'button';
  btn.className = 'tg-showall';
  btn.textContent = 'Show all ' + cards.length + ' testimonials';
  grid.parentNode.insertBefore(btn, grid.nextSibling);
  function openAll() { sec.classList.remove('tg-collapsed'); btn.remove(); }
  btn.addEventListener('click', openAll);
  var ta = document.getElementById('toggleAll');
  if (ta) ta.addEventListener('click', openAll);
});
  </script>
  <script is:inline defer>
/* Video previews show a frame from just before the end; playback starts from the beginning. */
window.addEventListener('load', function () {
  document.querySelectorAll('video[controls]').forEach(function (v) {
    function preview() {
      if (v.duration && isFinite(v.duration)) v.currentTime = Math.max(0, v.duration - 0.5);
    }
    if (v.readyState >= 1) preview();
    else v.addEventListener('loadedmetadata', preview, { once: true });
    v.addEventListener('play', function () {
      if (!v.dataset.tgPlayed) {
        v.dataset.tgPlayed = '1';
        if (v.currentTime > 1) v.currentTime = 0;
      }
    });
  });
});
  </script>
</Base>
