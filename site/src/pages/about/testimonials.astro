---
import Base from '../../layouts/Base.astro';
import body from '../../html/thorne-testimonials.html?raw';
import '../../styles/pages/thorne-testimonials.css';
---
<Base
  title="A business built on Reputation, Reviews and Testimonials | Thorne Group, Bay of Plenty"
  description="Award-winning architectural builders in Tauranga for 20 years. 100+ client testimonials and voted Most Trusted Architectural Builder 5 years running."
>
  <thorne-testimonials set:html={body}></thorne-testimonials>
  <script is:inline defer src="/js/lightdom-shim.js?v=1"></script>
  <script is:inline defer src="/js/thorne-testimonials26.js?v=4"></script>
  <script is:inline defer>
/* A handful of cards show first. Expand all reveals every card in its normal
   collapsed look (one long page); each card's + opens its full story. */
window.addEventListener('load', function () {
  var sec = document.getElementById('tg-voices'), grid = document.getElementById('grid');
  if (!sec || !grid) return;
  if (grid.querySelectorAll('.t-card').length <= 9) return;
  sec.classList.add('tg-collapsed');
  var ta = document.getElementById('toggleAll');
  if (!ta) return;
  var btn = ta.cloneNode(true); /* clone drops the engine's expand-everything handler */
  ta.parentNode.replaceChild(btn, ta);
  btn.textContent = 'Show all';
  btn.addEventListener('click', function () {
    sec.classList.remove('tg-collapsed');
    btn.style.display = 'none';
  });
});
  </script>
  <script is:inline defer>
/* Video previews show a frame from three quarters through; playback starts from the beginning. */
window.addEventListener('load', function () {
  document.querySelectorAll('video[controls]').forEach(function (v) {
    function preview() {
      if (v.duration && isFinite(v.duration)) v.currentTime = v.duration * 0.75;
    }
    if (v.readyState >= 1) preview();
    else v.addEventListener('loadedmetadata', preview, { once: true });
    v.addEventListener('play', function () {
      if (!v.dataset.tgPlayed) {
        v.dataset.tgPlayed = '1';
        if (v.currentTime > 1) v.currentTime = 0;
      }
    });
  });
});
  </script>
</Base>
