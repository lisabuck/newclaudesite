---
/* Our process: standalone page at /our-process, shared by link only. Not in
   any menu or the sitemap, and marked noindex like the other standalone pages
   (client guides, design brief). The 12 design + build steps are dark boxes
   in a column with a big arrow between each: a large number, the step title and a
   one-line summary, with a + that drops down the full detail. The two pricing
   checks before consent carry a cream label, and the band under the heading
   sums them up. */
import '../styles/fonts.css';

const LOGO = 'https://static.wixstatic.com/media/b2375c_d131631007ca414294e9b97aadae5e77~mv2.png';
const BRIEF = 'https://www.thornegroup.co.nz/brief';
const tick = (i: string) => `<li><span class="mk"></span><span>${i}</span></li>`;
const ticks = (items: string[], two = false) =>
  '<ul class="ticks' + (two ? ' two' : '') + '">' + items.map(tick).join('') + '</ul>';
---
<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Our Process | Thorne Group</title>
  <style is:global>
    html{scroll-behavior:smooth}
    body{margin:0;background:#FAF9F6;color:#393533;font-family:'Metric','Helvetica Neue',Helvetica,sans-serif;font-weight:300;-webkit-font-smoothing:antialiased}
    .op *{box-sizing:border-box}
    .op a{color:#393533}
    .op strong{font-weight:500}

    /* header: logo and page label, same as the client guides */
    .op-top{position:sticky;top:0;z-index:5;background:#FAF9F6;border-bottom:1px solid #c8c3bb}
    .op-wrap{max-width:1080px;margin:0 auto;padding-left:24px;padding-right:24px}
    .op-r1{padding-top:18px;padding-bottom:14px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px 24px}
    .op-logo{height:66px;max-width:none;margin-left:-20px;width:auto;display:block;filter:brightness(0) invert(21%) sepia(6%) saturate(600%) hue-rotate(340deg)}
    .op-kick{font-weight:400;font-size:14px;letter-spacing:.35em;text-transform:uppercase;color:#7a746e}
    @media (max-width:1000px){ .op-logo{height:54px;margin-left:-17px} }
    @media (max-width:750px){ .op-top{position:static} .op-logo{height:60px;margin-left:-19px} }
    @media (max-width:430px){ .op-logo{height:53px;margin-left:-16px} }

    .op-main{padding-top:56px;padding-bottom:80px}
    .col{max-width:900px}
    .eb{margin:0 0 22px;font-weight:400;font-size:14px;letter-spacing:.35em;text-transform:uppercase;color:#7a746e}
    .op h1{margin:0;font-weight:300;font-size:clamp(36px,5vw,56px);line-height:1.1;letter-spacing:-.02em;color:#393533}

    /* the short version: design, price, refine, price again, consent */
    .key{margin-top:40px;background:#393533;color:#FAF9F6;padding:32px 36px 34px}
    .key .eb{color:#c8c3bb;margin-bottom:20px}
    .key-flow{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;align-items:center;gap:12px 10px}
    .key-flow li{display:flex;align-items:center;gap:10px}
    .key-flow a{display:block;padding:12px 18px;border:1px solid rgba(250,249,246,.45);color:#FAF9F6;text-decoration:none;font-weight:400;font-size:14px;letter-spacing:.2em;text-transform:uppercase;white-space:nowrap;transition:background .2s ease,color .2s ease}
    .key-flow a:hover{background:rgba(250,249,246,.12)}
    .key-flow a.pr{background:#FAF9F6;color:#393533;border-color:#FAF9F6}
    .key-flow a.pr:hover{background:#e9e5df}
    .key-flow .ar{font-size:18px;color:#c8c3bb;line-height:1}
    .key-line{margin:24px 0 0;max-width:34em;font-size:20px;line-height:1.5;letter-spacing:-.01em;color:#FAF9F6}

    /* open / close every step */
    .bar{display:flex;justify-content:flex-end;margin:48px 0 14px}
    .all{background:none;border:0;padding:8px 0;cursor:pointer;font-family:inherit;font-weight:400;font-size:14px;letter-spacing:.2em;text-transform:uppercase;color:#393533;border-bottom:1px solid #393533}
    .all:hover{opacity:.6}

    /* the steps: one box each, a big arrow between them */
    .steps{list-style:none;margin:0;padding:0}
    .step{scroll-margin-top:130px}
    .box{border:1px solid #393533;background:#393533}
    .head{display:grid;grid-template-columns:96px 1px minmax(0,1fr) 210px 44px;align-items:center;gap:0 28px;padding:24px 28px 24px 24px;cursor:pointer;list-style:none}
    .head.np{grid-template-columns:96px 1px minmax(0,1fr) 44px}
    .ph{display:block;width:210px;aspect-ratio:3/2;overflow:hidden;background:#4a4542}
    .ph img{display:block;width:100%;height:100%;object-fit:cover}
    .head::-webkit-details-marker{display:none}
    .head:focus-visible{outline:1px solid #FAF9F6;outline-offset:-6px}
    .num{font-weight:300;font-size:64px;line-height:1;letter-spacing:-.02em;color:#FAF9F6;text-align:center}
    .rule{align-self:stretch;background:rgba(250,249,246,.3)}
    .tt{display:grid;gap:8px}
    .tag{font-weight:400;font-size:14px;letter-spacing:.3em;text-transform:uppercase;color:#c8c3bb}
    .tt h2{margin:0;font-weight:500;font-size:17px;line-height:1.4;letter-spacing:.12em;text-transform:uppercase;color:#FAF9F6}
    .sum{margin:0;font-weight:400;font-size:18px;line-height:1.5;color:#e6e1da}
    .pm{position:relative;justify-self:end;width:44px;height:44px;border:1px solid #FAF9F6;transition:background .2s ease}
    .pm::before,.pm::after{content:'';position:absolute;left:50%;top:50%;width:16px;height:1px;background:#FAF9F6;transform:translate(-50%,-50%)}
    .pm::after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .2s ease}
    details[open] .pm::after{transform:translate(-50%,-50%) rotate(0deg)}
    .head:hover .pm{background:rgba(250,249,246,.12)}
    .more{padding:4px 28px 30px calc(24px + 96px + 28px + 1px + 28px)}
    .more p{margin:0 0 12px;font-weight:400;font-size:18px;line-height:1.75;color:#e6e1da}
    .more p:last-child{margin-bottom:0}
    .more > :first-child{padding-top:22px;border-top:1px solid rgba(250,249,246,.3)}
    .op a.go{display:inline-block;margin-top:8px;font-weight:400;font-size:14px;letter-spacing:.2em;text-transform:uppercase;color:#FAF9F6;text-decoration:none;border-bottom:1px solid #FAF9F6;padding-bottom:4px}
    .op a.go:hover{opacity:.6}
    .down{display:flex;justify-content:center;padding:14px 0;width:96px;margin-left:25px}
    .down svg{display:block}

    /* the two pricing checks: a cream label, like the Price boxes in the band */
    .step.price .tag{justify-self:start;padding:6px 10px 5px;background:#FAF9F6;color:#393533;letter-spacing:.22em}

    /* ticked lists */
    .ticks{list-style:none;margin:6px 0 4px;padding:0;border-bottom:1px solid rgba(250,249,246,.25)}
    .ticks li{display:flex;gap:14px;align-items:flex-start;padding:10px 0;border-top:1px solid rgba(250,249,246,.25);font-weight:400;font-size:17px;line-height:1.5;color:#FAF9F6}
    .ticks .mk{flex:none;width:13px;height:13px;border:1px solid #c8c3bb;margin-top:6px}
    .ticks.two{display:grid;grid-template-columns:1fr 1fr;gap:0 28px}

    /* step 2: two options; step 5: the decision */
    .opts,.outs{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:6px}
    .opt,.out{background:transparent;border:1px solid rgba(250,249,246,.3);padding:20px 22px 22px}
    .opt .tag,.out .tag{display:block;margin-bottom:8px}
    .opt h3{margin:0 0 8px;font-weight:300;font-size:21px;line-height:1.3;letter-spacing:-.01em;color:#FAF9F6}
    .opt p,.out p{font-size:17px}
    .both{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:4px 0 18px}
    .both span{padding:10px 16px;border:1px solid rgba(250,249,246,.6);font-weight:400;font-size:15px;letter-spacing:.06em;color:#FAF9F6;background:transparent}
    .both .plus{padding:0;border:0;background:none;font-size:22px;color:#c8c3bb}


    .op-foot{border-top:1px solid #c8c3bb}
    .op-foot .op-wrap{padding-top:22px;padding-bottom:40px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 24px;font-weight:400;font-size:14px;letter-spacing:.15em;text-transform:uppercase;color:#7a746e}
    .op-foot a{color:#7a746e;text-decoration:none}

    /* tablets: a smaller number column */
    @media (max-width:1000px){
      .head{grid-template-columns:76px 1px minmax(0,1fr) 150px 44px;gap:0 22px}
      .head.np{grid-template-columns:76px 1px minmax(0,1fr) 44px}
      .ph{width:150px}
      .num{font-size:54px}
      .more{padding-left:calc(24px + 76px + 22px + 1px + 22px)}
      .down{width:76px}
    }
    /* phones: the number sits above the title, the detail runs full width,
       and the short version runs down the band with arrows pointing down */
    @media (max-width:750px){
      .op-main{padding-top:40px;padding-bottom:56px}
      .key{margin-top:32px;padding:26px 22px 28px}
      .key-flow{flex-direction:column;align-items:stretch;gap:6px}
      .key-flow li{flex-direction:column;align-items:stretch;gap:6px}
      .key-flow a{text-align:center}
      .key-flow .ar{transform:rotate(90deg);text-align:center;align-self:center}
      .key-line{font-size:18px}
      .bar{margin-top:36px}
      .head,.head.np{grid-template-columns:minmax(0,1fr) auto 40px;grid-template-areas:"num ph pm" "tt tt tt";gap:12px 14px;padding:18px 16px 20px 16px;align-items:center}
      .ph{grid-area:ph;width:96px}
      .num{grid-area:num;justify-self:start;width:44px;font-size:40px;text-align:left}
      .rule{display:none}
      .tt{grid-area:tt}
      .pm{grid-area:pm}
      .tt h2{font-size:15px;letter-spacing:.1em}
      .sum{font-size:17px}
      .pm{width:40px;height:40px}
      .more{padding:2px 16px 24px}
      .more p{font-size:17px}
      .ticks.two,.opts,.outs{grid-template-columns:1fr}
      .down{width:44px;margin-left:17px;padding:10px 0}
    }
    @media (prefers-reduced-motion:reduce){ html{scroll-behavior:auto} .pm,.pm::after{transition:none} }
  </style>
</head>
<body>
<div class="op">
  <header class="op-top">
    <div class="op-wrap op-r1">
      <a href="https://www.thornegroup.co.nz"><img class="op-logo" src={LOGO} alt="Thorne Group" /></a>
      <span class="op-kick">Our process</span>
    </div>
  </header>

  <main class="op-wrap op-main">
    <div class="col">
      <p class="eb">Our process</p>
      <h1>Design + Build Process</h1>

      <section class="key" aria-label="Two pricing checks before consent">
        <p class="eb">Two pricing checks before consent</p>
        <ol class="key-flow">
          <li><a href="#step-3">Design</a><span class="ar" aria-hidden="true">&rarr;</span></li>
          <li><a class="pr" href="#step-4">Price</a><span class="ar" aria-hidden="true">&rarr;</span></li>
          <li><a href="#step-5">Refine</a><span class="ar" aria-hidden="true">&rarr;</span></li>
          <li><a class="pr" href="#step-7">Price again</a><span class="ar" aria-hidden="true">&rarr;</span></li>
          <li><a href="#step-9">Consent</a></li>
        </ol>
        <p class="key-line">We price the design twice before it goes to consent. You see the likely cost while the design can still change, not after the whole house is drawn.</p>
      </section>

      <div class="bar"><button class="all" type="button" aria-expanded="false">Open all steps</button></div>

      <ol class="steps">
        <li class="step" id="step-1">
          <details class="box">
            <summary class="head"><span class="num">01</span><span class="rule"></span><div class="tt"><h2>Complete the Design Brief</h2><span class="sum">Your site, how you want to live, your priorities, style and budget.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_70854ba20b7d4ce4ae68d390bd3e5cb1~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-1.jpg" alt="A house design on an iPad beside architecture books" loading="lazy" decoding="async" style="object-position:55% 50%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>We start by understanding the site, how you want to live, your priorities, style, budget and what is most important to you.</p>
              <p>This gives us a clear brief to work from before design begins.</p>
              <a class="go" href={BRIEF}>Start the Design Brief &rarr;</a>
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step" id="step-2">
          <details class="box">
            <summary class="head"><span class="num">02</span><span class="rule"></span><div class="tt"><h2>Match the Right Architect or Architectural Designer</h2><span class="sum">We recommend the architect or designer best suited to your project.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_1c8bb5882e124aaa9fb80ee64c5fd9b5~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-2.jpg" alt="Three people looking through designs on an iPad" loading="lazy" decoding="async" style="object-position:50% 35%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>Based on the brief, we recommend the architect or designer we think is best suited to the project, considering style, budget, site, project complexity and how they work.</p>
              <p>There are two ways we can approach this:</p>
              <div class="opts">
                <div class="opt">
                  <span class="tag">Option A</span>
                  <h3>Select one architect</h3>
                  <p>We recommend the architect we believe is the best fit and move directly into the concept design process with them.</p>
                </div>
                <div class="opt">
                  <span class="tag">Option B</span>
                  <h3>Invite more than one architect to put forward a concept</h3>
                  <p>If appropriate, two or more architects could be asked to develop an initial concept for consideration. There would generally be a fee from each architect for this work.</p>
                </div>
              </div>
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step" id="step-3">
          <details class="box">
            <summary class="head"><span class="num">03</span><span class="rule"></span><div class="tt"><h2>Concept / Scheme Design</h2><span class="sum">The architect develops the initial concept. We review it together.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_ae9ee23419f446479ba4a6adaf5bd50f~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-3.jpg" alt="Sketching a floor plan" loading="lazy" decoding="async" style="object-position:50% 50%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>The selected architect develops the initial concept for the home.</p>
              <p>At this stage we review the design with the client and architect, looking at things such as:</p>
              <Fragment set:html={ticks(['Overall layout and size', 'How the home sits on the site', 'Buildability', 'Structural complexity', 'Materials', 'Areas that may have a significant impact on cost'], true)} />
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step price" id="step-4">
          <details class="box">
            <summary class="head"><span class="num">04</span><span class="rule"></span><div class="tt"><span class="tag">Pricing check 1 of 2</span><h2>Initial Pricing Review</h2><span class="sum">We compare the early design with your budget, before too much design work is done.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_20efe99371704e3f942f240180e49d96~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-4.jpg" alt="Reviewing a 3D design on screen" loading="lazy" decoding="async" style="object-position:50% 30%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>Once there is enough detail in the scheme, we carry out an initial pricing review.</p>
              <p>This is deliberately done early, before too much design work has been completed.</p>
              <p>We compare the emerging design with the agreed budget and identify any areas that may need to be reconsidered.</p>
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step" id="step-5">
          <details class="box">
            <summary class="head"><span class="num">05</span><span class="rule"></span><div class="tt"><h2>Client Review</h2><span class="sum">You decide if you are happy with the design and the likely investment.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_c46c6927effa4f0db72de39115f08181~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-5.jpg" alt="Talking through the design at the table" loading="lazy" decoding="async" style="object-position:50% 40%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>The client then decides whether they are happy with:</p>
              <div class="both"><span>The design</span><span class="plus" aria-hidden="true">+</span><span>The likely level of investment</span></div>
              <div class="outs">
                <div class="out">
                  <span class="tag">Happy with both</span>
                  <p>Move on to design development.</p>
                </div>
                <div class="out">
                  <span class="tag">Changes needed</span>
                  <p>The architect, client and Thorne Group work through them together before progressing.</p>
                </div>
              </div>
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step" id="step-6">
          <details class="box">
            <summary class="head"><span class="num">06</span><span class="rule"></span><div class="tt"><h2>Design Development</h2><span class="sum">The architect develops the design in more detail.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_b83542c653a8446394a0a7f9e7b2c29b~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-6.jpg" alt="Detailed drawings in progress" loading="lazy" decoding="async" style="object-position:40% 50%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>Once the overall concept and budget are aligned, the architect develops the design further.</p>
              <p>More detailed decisions are made around construction, materials, specification, interiors and key architectural details.</p>
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step price" id="step-7">
          <details class="box">
            <summary class="head"><span class="num">07</span><span class="rule"></span><div class="tt"><span class="tag">Pricing check 2 of 2</span><h2>Second Pricing Check</h2><span class="sum">We price it again as the design develops, before the plans go to consent.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_50c35f23740d479fa4cea38b82dc9da7~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-7.jpg" alt="Going through the plans together" loading="lazy" decoding="async" style="object-position:50% 50%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>We price the project again as the design develops.</p>
              <p>This gives another opportunity to identify cost movements and make informed decisions before the plans are completed and submitted for consent.</p>
              <p>If necessary, elements can be redesigned, simplified or reprioritised at this stage.</p>
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step" id="step-8">
          <details class="box">
            <summary class="head"><span class="num">08</span><span class="rule"></span><div class="tt"><h2>Client Approval to Proceed</h2><span class="sum">You approve the developed design and updated pricing.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_084da0b18d67401abbe9a74ac1d7f9ad~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-8.jpg" alt="Approval to proceed" loading="lazy" decoding="async" style="object-position:50% 50%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>Once the client is comfortable with the developed design and updated pricing, approval is given to move forward.</p>
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step" id="step-9">
          <details class="box">
            <summary class="head"><span class="num">09</span><span class="rule"></span><div class="tt"><h2>Detailed Documentation + Building Consent</h2><span class="sum">The construction drawings are completed and lodged for consent.</span></div><span class="ph"><img src="https://static.wixstatic.com/media/b2375c_bdadd0a0b6bb4d58b71dedfe64e09241~mv2.jpg/v1/fit/w_640,h_640,q_80,enc_auto/our-process-9.jpg" alt="Plans and pricing on a computer screen" loading="lazy" decoding="async" style="object-position:60% 50%" /></span><span class="pm" aria-hidden="true"></span></summary>
            <div class="more"><div>
              <p>The architect completes the detailed construction documentation required for building consent.</p>
              <p>Engineering and other specialist consultants are coordinated as required, and the project is lodged for consent.</p>
            </div></div>
          </details>
        </li>
        <li class="down" aria-hidden="true"><svg width="20" height="40" viewBox="0 0 20 40"><path d="M10 1v36M2 29l8 8 8-8" fill="none" stroke="#393533" stroke-width="1.4"/></svg></li>

        <li class="step" id="step-10">
          <details class="box">
