<script is:inline>
(function () {
  var boxes = Array.prototype.slice.call(document.querySelectorAll('.steps details'));
  var all = document.querySelector('.all');
  function sync() {
    var open = boxes.every(function (d) { return d.open; });
    all.textContent = open ? 'Close all steps' : 'Open all steps';
    all.setAttribute('aria-expanded', String(open));
  }
  all.addEventListener('click', function () {
    var open = !boxes.every(function (d) { return d.open; });
    boxes.forEach(function (d) { d.open = open; });
    sync();
  });
  boxes.forEach(function (d) { d.addEventListener('toggle', sync); });
  /* a link to a step (the band, or /our-process#step-4) opens that step */
  function openFromHash() {
    var el = location.hash && document.getElementById(location.hash.slice(1));
    var d = el && el.querySelector('details');
    if (d) d.open = true;
  }
  window.addEventListener('hashchange', openFromHash);
  openFromHash();
})();
</script>
