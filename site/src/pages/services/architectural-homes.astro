---
import Base from '../../layouts/Base.astro';
import body from '../../html/thorne-arch-homes.html?raw';
import '../../styles/pages/thorne-home-page.css';
import '../../styles/pages/arch-homes-extra.css';
---
<Base
  title="Building with Tauranga's Leading Architects | Thorne Group"
  description="Building award-winning homes in partnership with leading architects and designers for 20 years. From concept to completion. Aligning design, budget and buildability."
>
  <thorne-home-page set:html={body}></thorne-home-page>
  <script is:inline>
/* "Give us a call" under Pricing: phones dial the office straight away;
   tablets and computers show the office and Clare's numbers instead */
document.addEventListener('click', function (e) {
  var b = e.target.closest && e.target.closest('.ah-callbtn');
  if (!b || window.matchMedia('(max-width:750px)').matches) return;
  var nums = b.parentNode.querySelector('.ah-callnums'); if (!nums) return;
  e.preventDefault();
  nums.hidden = !nums.hidden;
  b.setAttribute('aria-expanded', nums.hidden ? 'false' : 'true');
});
  </script>
</Base>
