---
import Base from '../../layouts/Base.astro';
import body from '../../html/thorne-renovation.html?raw';
import '../../styles/pages/thorne-renovation.css';
---
<Base
  title="Renovations Tauranga | Renovate, Extend or Rebuild | Thorne Group"
  description="20 years of experience and expertise to help weigh up options. Free consultation and feasibility advice to help you choose the best pathway."
>
  <thorne-renovation set:html={body}></thorne-renovation>
  <script is:inline defer>
/* Ticks the 10-point guide off item by item when it scrolls into view. */
(function () {
  var sec = document.querySelector('.rn-check');
  if (!sec || !('IntersectionObserver' in window)) return;
  var ticks = sec.querySelectorAll('.rn-tick');
  for (var i = 0; i < ticks.length; i++) ticks[i].style.setProperty('--d', (i * 0.5) + 's');
  sec.classList.add('rn-armed');
  var io = new IntersectionObserver(function (entries) {
    if (!entries.some(function (e) { return e.isIntersecting; })) return;
    io.disconnect();
    sec.classList.add('rn-on');
  }, { threshold: 0.25 });
  io.observe(sec.querySelector('.rn-check-list'));
})();
  </script>
</Base>
